local httpRequest = http_request or request or (http and http.request) or (syn and syn.request)

if not httpRequest then
	return warn("[CatVape] Your executor has no 'request' function.")
end
if repo_token == "TOKEN-HERE" or #repo_token < 20 then
	return warn("[CatVape] Put your GitHub token inside the quotes on the repo_token line.")
