local function ghGet(url)
	local res = httpRequest({
		Url = url,
		Method = "GET",
		Headers = { Authorization = "token " .. repo_token, ["User-Agent"] = "CatVape" }
	})
	return res.Body or res.body, res.StatusCode or res.status_code or 0
end

if not getgenv().__repoAuth then
	if hookmetamethod and getnamecallmethod and newcclosure then
		getgenv().__repoAuth = true
		local old
		old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
			if getnamecallmethod() == "HttpGet" then
				local url = ...
				if type(url) == "string" and url:find(repo, 1, true) then
					local body, code = ghGet(url)
					if code >= 200 and code < 300 then return body end
				end
			end
			return old(self, ...)
		end))
	else
		warn("[CatVape] Executor missing hookmetamethod/newcclosure - needed for private loading.")
	end
end

local body, code = ghGet("https://raw.githubusercontent.com/" .. repo .. "/main/init.lua")
